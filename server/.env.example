# MailWave backend — environment variables.
#
# Copy this file to `.env` in this same folder and fill in real values.
# `.env` itself is gitignored — never commit real credentials.
#
# Nothing here is provider-specific. Moving MailWave to different hosting,
# a different Postgres provider, a different SMTP/email provider, or a
# different domain should only ever mean changing values in this file —
# not changing any application code.

# -----------------------------------------------------------------------------
# Database — REQUIRED for any real deployment
# -----------------------------------------------------------------------------

# Standard Postgres connection string. Works with any Postgres 13+ provider —
# Neon, Supabase, Render Postgres, AWS RDS, DigitalOcean, a self-hosted box,
# etc. If this is left empty, the server falls back to PGlite (an embedded
# database stored in a local folder) — fine for trying the app on your own
# computer, but NOT durable enough for a real deployment: the folder can be
# corrupted by an unclean shutdown.
# Example: postgres://user:password@host:5432/mailwave
DATABASE_URL=

# Set to "true" if your provider needs an explicit SSL flag rather than
# putting sslmode= in the connection string itself. Most hosted providers
# already include sslmode in their connection string and don't need this.
DATABASE_SSL=false

# Only used when DATABASE_URL is empty (PGlite/local mode) — where the
# embedded database's files are kept.
# DATA_DIR=./data/pgdata

# -----------------------------------------------------------------------------
# Sessions / security — REQUIRED for any real deployment
# -----------------------------------------------------------------------------

# Signs access/refresh tokens. If left unset, the server generates a random
# one on first boot and saves it back to this .env file — convenient for a
# first local run, but a real deployment should set its own, or every deploy
# that loses the generated file logs every signed-in user out.
JWT_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# SameSite mode for the refresh-token cookie. Leave as "lax" if the frontend
# and backend share a registrable domain (e.g. app.example.com talking to
# api.example.com — this is the common case, subdomains are fine). Only set
# to "none" if frontend and backend are on two completely UNRELATED domains
# (e.g. app.example.com calling api.otherdomain.com) — otherwise sign-in
# silently stops surviving past the access token's short lifetime.
AUTH_COOKIE_SAMESITE=lax

# Comma-separated list of origins allowed to call this API from a browser.
# Must include the exact origin(s) your frontend is actually served from.
# Get this wrong and the whole app will look "broken" with no obvious error —
# the browser blocks the request before it reaches this server at all.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# -----------------------------------------------------------------------------
# URLs — REQUIRED for any real deployment
# -----------------------------------------------------------------------------

# This backend's own public URL. Used to build tracking pixels, click-tracking
# redirects, unsubscribe links and image links inside sent email — get this
# wrong and images/tracking will look broken in emails that already went out.
PUBLIC_URL=http://localhost:4000

# The frontend's public URL. Used to build links inside system emails (e.g.
# "reset your password", "view this campaign").
APP_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# First-run setup
# -----------------------------------------------------------------------------

PORT=4000
NODE_ENV=production

# Only used the very first time the database is seeded (an empty database —
# this has no effect on an already-set-up install). In production, if
# SEED_PASSWORD is left empty, a random one is generated and printed to the
# console once — capture it immediately, sign in, then change it from
# Settings > Security. Do not rely on a guessable default in production.
SEED_EMAIL=admin@example.com
SEED_PASSWORD=
ADMIN_NAME=Admin

# -----------------------------------------------------------------------------
# Email sending
# -----------------------------------------------------------------------------

# smtp (default) — real email accounts, connected from inside the app itself
#   (Email Accounts page) — Gmail, Outlook, Zoho, SendGrid-via-SMTP, Amazon
#   SES-via-SMTP, or any generic SMTP server. Nothing provider-specific here;
#   accounts are configured through the UI, not through env vars.
# ethereal — a fake test inbox (nodemailer's testing service). Never use in
#   production — no real mail is delivered, only a preview link.
# json — dry run; nothing is sent anywhere, only logged.
MAIL_TRANSPORT=smtp

# Which connected account MailWave's OWN emails (password reset, invites,
# alerts) are sent from. Leave empty to use whichever account was connected
# first. Set this if you want those to come from a dedicated address, e.g.
# no-reply@yourdomain.com.
SYSTEM_EMAIL_FROM=

# -----------------------------------------------------------------------------
# Backups
# -----------------------------------------------------------------------------

BACKUP_EVERY_DAYS=7
BACKUP_KEEP=8

# local — the server's own disk. On most hosting (Render included) this disk
#   is NOT durable — it can be wiped on redeploy/restart. Fine to try things
#   out, not something to rely on for a real deployment.
# s3    — any S3-compatible object storage: AWS S3, Cloudflare R2, Backblaze
#   B2, DigitalOcean Spaces, MinIO, etc. Survives redeploys/restarts.
BACKUP_STORAGE=local

# Only used when BACKUP_STORAGE=local.
# BACKUP_DIR=./data/backups

# Only used when BACKUP_STORAGE=s3. BACKUP_S3_ENDPOINT is what selects the
# provider — leave it empty for real AWS S3, or set it to your provider's
# endpoint URL for anything else (R2, B2, Spaces, MinIO...).
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Most S3-compatible providers (R2, Spaces, MinIO) need this "true". Real AWS
# S3 works with either.
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_S3_PREFIX=mailwave-backups/

# -----------------------------------------------------------------------------
# Diagnostics (optional — sensible defaults, rarely need changing)
# -----------------------------------------------------------------------------

# Mirrors all console output to a file as well (default: a temp-folder path
# that varies by OS). Useful for support/debugging regardless of how the
# server was started.
# MW_SERVER_LOG=
